{
  "name": "@hyzyn/dsh-hello",
  "version": "0.1.2",
  "description": "dsh-plugin-kit 的最小 host 插件模板：dsh manifest、bundle patch 与构建配置的参考实现，也是 pnpm create-plugin 的复制蓝本。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@hyzyn/dsh-kit": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git",
    "directory": "packages/hello"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit/tree/main/packages/hello#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

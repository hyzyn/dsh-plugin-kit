{
  "name": "@hyzyn/dsh-devdata",
  "version": "0.1.0",
  "private": true,
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "开发/测试环境的数据面与编排工具（SQL 只读 / NoSQL 受限 / 消息中间件 / 环境编排）：面向 agent 的工具注册 + 操作级能力裁决 + 审计。私有包，不发布。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./scope.js": {
      "types": "./lib/scope.d.ts",
      "default": "./lib/scope.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@hyzyn/dsh-kit": "0.8.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "host-mount-smoke": "node ../../scripts/verify-devdata-host-mount.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node ../../scripts/verify-devdata-all.mjs"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git",
    "directory": "packages/devdata"
  }
}

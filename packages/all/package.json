{
  "name": "@hyzyn/dsh-all",
  "version": "0.1.14",
  "description": "dsh-plugin-kit 聚合安装包：一条 bundle patch 挂载仓库内全部插件（cordis.patch.yml 与 dependencies 由 scripts/aggregate.mjs 自动生成，勿手改）。",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugins",
    "aggregate",
    "bundle",
    "terminal",
    "ssh",
    "sftp",
    "tmux",
    "rss",
    "search",
    "agent",
    "cordis"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@hyzyn/dsh-codegraph": "workspace:*",
    "@hyzyn/dsh-env": "workspace:*",
    "@hyzyn/dsh-mcp": "workspace:*",
    "@hyzyn/dsh-profile": "workspace:*",
    "@hyzyn/dsh-prompt": "workspace:*",
    "@hyzyn/dsh-rss": "workspace:*",
    "@hyzyn/dsh-search": "workspace:*",
    "@hyzyn/dsh-tty": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "~5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git",
    "directory": "packages/all"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit/tree/main/packages/all#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

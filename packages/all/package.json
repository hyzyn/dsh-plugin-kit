{
  "name": "@hyzyn/dsh-all",
  "version": "0.1.4",
  "description": "dsh-plugin-kit 聚合安装包：一条 bundle patch 挂载仓库内全部插件（cordis.patch.yml 与 dependencies 由 scripts/aggregate.mjs 自动生成，勿手改）。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@hyzyn/dsh-codegraph": "workspace:*",
    "@hyzyn/dsh-env": "workspace:*",
    "@hyzyn/dsh-hello": "workspace:*",
    "@hyzyn/dsh-mcp": "workspace:*",
    "@hyzyn/dsh-profile": "workspace:*",
    "@hyzyn/dsh-prompt": "workspace:*",
    "@hyzyn/dsh-rss": "workspace:*",
    "@hyzyn/dsh-search": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "~5.7.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}

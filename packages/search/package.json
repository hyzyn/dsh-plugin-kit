{
  "name": "@hyzyn/dsh-search",
  "version": "0.4.4",
  "description": "DSH Web GUI 的全局搜索插件：侧边栏「全局搜索」（⌘/Ctrl + K）命令面板式一处检索历史会话、Prompt、MCP 工具与设置面板。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "sessions"
      ]
    }
  },
  "dependencies": {
    "@hyzyn/dsh-kit": "0.5.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^22.20.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "node scripts/route-smoke.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit && node ../../scripts/client-lint.mjs",
    "lint:client": "node ../../scripts/client-lint.mjs"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git",
    "directory": "packages/search"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit/tree/main/packages/search#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}

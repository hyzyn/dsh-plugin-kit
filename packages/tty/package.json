{
  "name": "@hyzyn/dsh-tty",
  "version": "0.20.0",
  "description": "DSH Web GUI 的终端面板插件：侧边栏「终端」大弹窗，xterm.js + PTY 全交互终端（路线1），ssh2 原生 SSH 远程连接（方案 C），tmux 会话持久化（0.10.0），连接栏扩展点 ttyConnbar（0.13.0）、终端服务 ttyTerminal（0.14.0 open / 0.15.0 mount 就地嵌入）、面板内挂载位 ttyPanel（0.16.0 右侧 dock）、服务器状态条（0.17.0：按标签可见性采端主机 CPU / 内存 / 磁盘 / 在线时长 / TCP / 网速 / 温度，SSH 走同连接的非 PTY exec channel、本地走 os/proc，best-effort、不碰 PTY 流）、连接密码存入官方凭据存储（0.18.0：字段里只留 env: 引用、引用名按资源身份派生、候选来自凭据存储 ∪ 连接簿；设置卡片的连接编辑与连接对话框共用同一套表单）、Windows 宿主支持（0.18.1：默认 shell = %COMSPEC%、不做 POSIX 包装层、PowerShell 走 -NoLogo/-Command；shell 集成 / tmux / 状态条三项在 Windows 本地不适用，README 有完整边界）。",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "terminal",
    "ssh",
    "sftp",
    "tmux",
    "xterm",
    "pty",
    "agent",
    "ai",
    "plugin",
    "web",
    "cordis"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@hyzyn/dsh-kit": "0.4.1",
    "@xterm/headless": "^5.5.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && node ../../scripts/client-lint.mjs",
    "probe": "node scripts/probe.mjs",
    "integration": "node scripts/integration.mjs",
    "live": "node scripts/live.mjs",
    "tui": "node scripts/tui-smoke.mjs",
    "preview": "node scripts/preview.mjs",
    "ssh-smoke": "node scripts/ssh-smoke.mjs",
    "probe-smoke": "node scripts/probe-smoke.mjs",
    "probe-route-smoke": "node scripts/probe-route-smoke.mjs",
    "sftplimits-smoke": "node scripts/sftplimits-smoke.mjs",
    "windows-smoke": "node scripts/windows-smoke.mjs",
    "lint:client": "node ../../scripts/client-lint.mjs"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "scripts"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git",
    "directory": "packages/tty"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit/tree/main/packages/tty#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@hyzyn/dsh-tty",
  "version": "0.30.0",
  "description": "DSH Web GUI 的终端面板插件：侧边栏「终端」提供 xterm.js + PTY 全交互终端与 ssh2 原生 SSH 远程连接（连接簿、主机指纹 TOFU、跳板机），支持 tmux 会话持久化、SFTP 文件传输、端口转发与服务器状态条，并向其他插件开放 ttyTerminal / ttyPanel / ttyConnbar 扩展点；Windows 宿主同样可用。",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "terminal",
    "ssh",
    "sftp",
    "tmux",
    "xterm",
    "pty",
    "agent",
    "ai",
    "plugin",
    "web",
    "cordis"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@hyzyn/dsh-kit": "0.5.2",
    "@xterm/headless": "^5.5.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.1-alpha.1 || ^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.1-alpha.1 || ^0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/node": "^22.20.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.12",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && node ../../scripts/client-lint.mjs",
    "probe": "node scripts/probe.mjs",
    "integration": "node scripts/integration.mjs",
    "live": "node scripts/live.mjs",
    "tui": "node scripts/tui-smoke.mjs",
    "preview": "node scripts/preview.mjs",
    "ssh-smoke": "node scripts/ssh-smoke.mjs",
    "probe-smoke": "node scripts/probe-smoke.mjs",
    "probe-route-smoke": "node scripts/probe-route-smoke.mjs",
    "jump-smoke": "node scripts/jump-smoke.mjs",
    "proxycommand-smoke": "node scripts/proxycommand-smoke.mjs",
    "sftplimits-smoke": "node scripts/sftplimits-smoke.mjs",
    "windows-smoke": "node scripts/windows-smoke.mjs",
    "lint:client": "node ../../scripts/client-lint.mjs"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "scripts"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git",
    "directory": "packages/tty"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit/tree/main/packages/tty#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}

{
  "name": "@hyzyn/dsh-kit",
  "version": "0.8.0",
  "description": "dsh-plugin-kit 插件开发工具包：宿主半体共享工具库（HTTP 围栏、托管区块、!!js 表达式、服务读取）与 definePlugin 类型助手。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ssh-exec": {
      "types": "./lib/ssh-exec.d.ts",
      "default": "./lib/ssh-exec.js"
    },
    "./tty-books": {
      "types": "./lib/tty-books.d.ts",
      "default": "./lib/tty-books.js"
    },
    "./audit": {
      "types": "./lib/audit.d.ts",
      "default": "./lib/audit.js"
    },
    "./manifest": {
      "types": "./lib/manifest.d.ts",
      "default": "./lib/manifest.js"
    },
    "./testing": {
      "types": "./lib/testing/fake-host.d.ts",
      "default": "./lib/testing/fake-host.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/ssh2": "^1.15.6",
    "typescript": "~5.9.3"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit/tree/main/packages/kit#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

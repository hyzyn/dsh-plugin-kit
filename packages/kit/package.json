{
  "name": "@dsh-kit/kit",
  "version": "0.0.0",
  "description": "dsh-plugin-kit 插件开发工具包：definePlugin 类型助手等共用代码，零运行时依赖。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib"
  ],
  "license": "MIT"
}

{
  "name": "@hyzyn/dsh-kit",
  "version": "0.3.0",
  "description": "dsh-plugin-kit 插件开发工具包：宿主半体共享工具库（HTTP 围栏、托管区块、!!js 表达式、服务读取）与 definePlugin 类型助手。",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.0",
    "typescript": "~5.9.3"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit/tree/main/packages/kit#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

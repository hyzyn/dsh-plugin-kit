{
  "name": "@hyzyn/dsh-plugin-kit",
  "version": "0.1.44",
  "type": "module",
  "description": "通用 DSH 插件库（pnpm monorepo）：模板插件、插件开发工具包、一键聚合安装包。根包同时是全家桶 bundle（dsh.bundle.patch），DSH 与插件市场可直接识别安装。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-plugin": "node scripts/create-plugin.mjs",
    "aggregate": "node scripts/aggregate.mjs",
    "live-smoke": "node scripts/live-host-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.30.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hyzyn/dsh-codegraph": "0.6.3",
    "@hyzyn/dsh-docker": "0.9.3",
    "@hyzyn/dsh-env": "0.3.3",
    "@hyzyn/dsh-kit-settings": "0.2.2",
    "@hyzyn/dsh-mcp": "0.2.4",
    "@hyzyn/dsh-profile": "0.2.3",
    "@hyzyn/dsh-prompt": "0.2.3",
    "@hyzyn/dsh-rss": "0.4.3",
    "@hyzyn/dsh-search": "0.4.3",
    "@hyzyn/dsh-tty": "0.22.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh": "link:scripts/dsh-peer-stub"
    }
  }
}

{
  "name": "@hyzyn/dsh-plugin-kit",
  "version": "0.1.51",
  "type": "module",
  "description": "通用 DSH 插件库（pnpm monorepo）：模板插件、插件开发工具包、一键聚合安装包。根包同时是全家桶 bundle（dsh.bundle.patch），DSH 与插件市场可直接识别安装。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-plugin": "node scripts/create-plugin.mjs",
    "aggregate": "node scripts/aggregate.mjs",
    "live-smoke": "node scripts/live-host-smoke.mjs",
    "verify:list": "node scripts/verify-list.mjs",
    "repro-flake": "node scripts/repro-flake.mjs",
    "aggregate:check": "node scripts/check-aggregate.mjs",
    "artifacts:check": "node scripts/check-artifacts.mjs",
    "publishable:check": "node scripts/check-publishable.mjs",
    "package-contents:check": "node scripts/check-package-contents.mjs",
    "flake:check": "node scripts/flake-lane.mjs",
    "coverage:check": "node scripts/coverage-ratchet.mjs",
    "coverage:write": "node scripts/coverage-ratchet.mjs --write",
    "dsh-peers:check": "node scripts/check-dsh-peers.mjs",
    "dsh-home:check": "node scripts/check-dsh-home.mjs",
    "kit-pins:check": "node scripts/check-kit-pins.mjs",
    "doc-links:check": "node scripts/check-doc-links.mjs",
    "test-collection:check": "node scripts/check-test-collection.mjs --self-test && node scripts/check-test-collection.mjs",
    "toolchain:check": "node scripts/check-toolchain-pins.mjs --self-test && node scripts/check-toolchain-pins.mjs",
    "engines:check": "node scripts/check-engine-strict.mjs --self-test && node scripts/check-engine-strict.mjs",
    "issue-forms:check": "node scripts/check-issue-forms.mjs --self-test && node scripts/check-issue-forms.mjs",
    "i18n:check": "node scripts/check-i18n.mjs --self-test && node scripts/check-i18n.mjs",
    "no-public-ip:check": "node scripts/check-no-public-ip.mjs --self-test && node scripts/check-no-public-ip.mjs",
    "no-public-ip:message": "node scripts/check-no-public-ip.mjs",
    "release:publish": "node scripts/release-publish-tag.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyzyn/dsh-plugin-kit.git"
  },
  "homepage": "https://github.com/hyzyn/dsh-plugin-kit#readme",
  "bugs": {
    "url": "https://github.com/hyzyn/dsh-plugin-kit/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hyzyn/dsh-codegraph": "0.6.8",
    "@hyzyn/dsh-docker": "0.12.0",
    "@hyzyn/dsh-env": "0.3.8",
    "@hyzyn/dsh-kit-settings": "0.2.5",
    "@hyzyn/dsh-mcp": "0.3.4",
    "@hyzyn/dsh-profile": "0.2.7",
    "@hyzyn/dsh-prompt": "0.2.7",
    "@hyzyn/dsh-rss": "0.4.7",
    "@hyzyn/dsh-search": "0.4.7",
    "@hyzyn/dsh-tty": "0.30.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.1-alpha.1 || ^0.2.1-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh": "link:scripts/dsh-peer-stub"
    }
  }
}

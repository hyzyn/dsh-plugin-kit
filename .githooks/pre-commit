#!/bin/sh
# 提交前强制重建：本仓库构建产物（packages/*/lib、packages/*/client.js）随源码
# 入库，此钩子保证提交里的产物永远与源码同步；构建失败则中止提交。
# 启用：git config core.hooksPath .githooks
#
# 路径通配的坑（实测）：git 的 pathspec 里 `packages/*/lib` **不会**递归匹配目录内容——
# `git diff` 能匹配到已跟踪文件，`git add` 却直接
# `fatal: pathspec 'packages/*/lib' did not match any files`。
# 旧版因此从未真正暂存过产物（只把 fatal 漏到 stderr、还照打成功提示）。
# 正确写法是 glob magic + `**`：`:(glob)packages/*/lib/**`。
SPEC_CLIENT=':(glob)packages/*/client.js'
SPEC_LIB=':(glob)packages/*/lib/**'
SPEC_SRC=':(glob)packages/*/src/**'
SPEC_CLIENT_SRC=':(glob)packages/*/client-src/**'

# ── 产物只加「源码也在这一笔提交里」的那些包 ─────────────────────────────────────
#
# 为什么不能无条件 `git add` 全部产物（2026-10-17 实测踩到）：在**脏树上做部分提交**时
# （只暂存了一部分文件，别的包的源码还没提交），重建出来的产物是按**未暂存**的源码构建的
# ——把它们加进来，这一笔提交里就出现「产物变了、对应源码没变」的错配。那次的形状：
# 一份只暂存 9 个文件的提交，钩子把 5 个包按未提交源码重建的 lib/ 一并加了进来。
#
# 判据两条（按包判，不是按整棵树判）：
#   ① 只加「`src` / `client-src` 的改动已经躺在 index 里」的包的产物；
#   ② 这些包的 `src` 在工作区**不能再有**未暂存改动——有的话，产物是按那份没进提交的源码
#      构建的，加了就是错配。此时**报错中止**，由人来决定怎么下一步（下面给了两条出路）。
# 这两条合起来同时挡住反方向：只暂存了产物、源码还在工作区（① 不成立 ⇒ 不加，且产物已经在
# index 里时 ② 会报出来）。
#
# `cut -d/ -f2`：`packages/<pkg>/src/…` 的第二段就是包名（产物路径同形）。
dirty_pkgs=$(git diff --name-only -- "$SPEC_SRC" "$SPEC_CLIENT_SRC" 2>/dev/null | cut -d/ -f2 | sort -u || true)
staged_pkgs=$(git diff --cached --name-only -- "$SPEC_SRC" "$SPEC_CLIENT_SRC" 2>/dev/null | cut -d/ -f2 | sort -u || true)

for pkg in $dirty_pkgs; do
  # 这一笔没碰这个包（它的源码与产物都不在 index 里）→ 与它无关，不动它的产物
  case " $staged_pkgs " in
    *" $pkg "*) ;;
    *) continue ;;
  esac
  echo "✘ [pre-commit] $pkg 的产物无法与这一笔提交的源码同步：它的 src 还有未暂存的改动"
  echo "   产物必须是**提交里的源码**构建出来的。二选一："
  echo "     · git add packages/$pkg                    # 把这个包一起提交"
  echo "     · git stash push -- packages/$pkg/src      # 把未暂存的改动挪开再提交"
  exit 1
done

if ! out=$(pnpm -r build 2>&1); then
  printf '%s\n' "$out"
  echo "✘ [pre-commit] 构建失败，提交中止"
  exit 1
fi

# 每个「源码在这一笔里」的包，取它**真的变了**的产物：已跟踪产物的改动 + 新出现的未跟踪
# 产物（新包首次构建时 lib/ 还没入库）。按文件逐个 `git add`——`git add` 一个匹配不到任何
# 文件 pathspec 会直接 fatal，而这些包未必都有 client.js（只有带浏览器半体的包才有）。
added=0
for pkg in $staged_pkgs; do
  files=$(
    {
      git diff --name-only -- "packages/$pkg/client.js" ":(glob)packages/$pkg/lib/**" 2>/dev/null || true
      git ls-files --others --exclude-standard -- "packages/$pkg/client.js" ":(glob)packages/$pkg/lib/**" 2>/dev/null || true
    } | grep -v '^$'
  )
  [ -z "$files" ] && continue
  # 产物路径不含空白（`packages/<pkg>/lib/<file>` 与 `packages/<pkg>/client.js`），按行拆安全
  for file in $files; do
    # 失败必须报出来并中止：静默失败会让提交里留下与源码不同步的产物
    if ! git add -- "$file"; then
      echo "✘ [pre-commit] 暂存构建产物失败，提交中止（$file）"
      exit 1
    fi
    added=$((added + 1))
  done
done

if [ "$added" -gt 0 ]; then
  echo "↻ [pre-commit] 构建产物已刷新并入本次提交（$added 个文件）"
fi

# 面板端 i18n 闸门（项目级 ROADMAP 第 3 项）：键集 / 占位符 / 用法三件事必须一致。
# 放在这里而不是只在 CI：写错键名是**只会让界面露键名**那类问题，本地提交时就该拦下。
if ! node scripts/check-i18n.mjs; then
  echo "✘ [pre-commit] 面板端 i18n 目录未通过（详见上方指引；方案见 docs/i18n.md）"
  exit 1
fi

# 公网 IP 闸门：**必须放在重建之后**（上面会 git add 产物，那些内容也要被扫到）。
# 为什么在 pre-commit 也要查文件内容：git 只在暂存内容上做提交，工作区里没暂存的脏内容
# 不进历史；但反向也成立——**已暂存**的才是要进历史的，所以按 index 扫（--staged），
# 而不是工作区。提交信息里的地址由 commit-msg 钩子查（那时消息才存在）。
if ! node scripts/check-no-public-ip.mjs --staged; then
  echo "✘ [pre-commit] 提交内容含公网 IP，已中止（详见上方指引）"
  exit 1
fi
exit 0

#!/bin/sh
# 提交前强制重建：本仓库构建产物（packages/*/lib、packages/*/client.js）随源码
# 入库，此钩子保证提交里的产物永远与源码同步；构建失败则中止提交。
# 启用：git config core.hooksPath .githooks
#
# 路径通配的坑（实测）：git 的 pathspec 里 `packages/*/lib` **不会**递归匹配目录内容——
# `git diff` 能匹配到已跟踪文件，`git add` 却直接
# `fatal: pathspec 'packages/*/lib' did not match any files`。
# 旧版因此从未真正暂存过产物（只把 fatal 漏到 stderr、还照打成功提示）。
# 正确写法是 glob magic + `**`：`:(glob)packages/*/lib/**`。
SPEC_CLIENT=':(glob)packages/*/client.js'
SPEC_LIB=':(glob)packages/*/lib/**'

if ! out=$(pnpm -r build 2>&1); then
  printf '%s\n' "$out"
  echo "✘ [pre-commit] 构建失败，提交中止"
  exit 1
fi

# 已跟踪产物的改动 + 新出现的未跟踪产物（新包首次构建时 lib/ 还没入库）
changed=$(git diff --name-only -- "$SPEC_CLIENT" "$SPEC_LIB" 2>/dev/null || true)
fresh=$(git ls-files --others --exclude-standard -- "$SPEC_CLIENT" "$SPEC_LIB" 2>/dev/null || true)
if [ -n "$changed$fresh" ]; then
  # 失败必须报出来并中止：静默失败会让提交里留下与源码不同步的产物
  if ! git add -- "$SPEC_CLIENT" "$SPEC_LIB"; then
    echo "✘ [pre-commit] 暂存构建产物失败，提交中止"
    exit 1
  fi
  echo "↻ [pre-commit] 构建产物已刷新并入本次提交"
fi

# 面板端 i18n 闸门（项目级 ROADMAP 第 3 项）：键集 / 占位符 / 用法三件事必须一致。
# 放在这里而不是只在 CI：写错键名是**只会让界面露键名**那类问题，本地提交时就该拦下。
if ! node scripts/check-i18n.mjs; then
  echo "✘ [pre-commit] 面板端 i18n 目录未通过（详见上方指引；方案见 docs/i18n.md）"
  exit 1
fi

# 公网 IP 闸门：**必须放在重建之后**（上面会 git add 产物，那些内容也要被扫到）。
# 为什么在 pre-commit 也要查文件内容：git 只在暂存内容上做提交，工作区里没暂存的脏内容
# 不进历史；但反向也成立——**已暂存**的才是要进历史的，所以按 index 扫（--staged），
# 而不是工作区。提交信息里的地址由 commit-msg 钩子查（那时消息才存在）。
if ! node scripts/check-no-public-ip.mjs --staged; then
  echo "✘ [pre-commit] 提交内容含公网 IP，已中止（详见上方指引）"
  exit 1
fi

# 内网标识闸门（2026-10-18 新增）：内网服务名 / 项目代号 / 登录账号 / 私网主机号。
# 公网 IP 闸门管不到这一类，而它才是实际反复泄露的东西——`92f01eaf6` 清过一轮，
# 一周后 `768b7720b` 又写回测试夹具。同样放在重建之后（产物里的注释也要被扫到），
# 同样按 **index** 扫：只有暂存的才进历史。提交信息里的那部分由 commit-msg 钩子查。
if ! node scripts/check-internal-identifiers.mjs --staged; then
  echo "✘ [pre-commit] 提交内容含真实内部标识，已中止（详见上方指引）"
  exit 1
fi

# README ↔ 源码常量一致性（2026-10-18 新增）：README 里写了常量名，数字就必须与源码对得上。
#
# 为什么必须在 pre-commit 而不是只放 CI：这道闸守的是「改常量时忘了改 README」那一类——
# 一旦提交出去，CI 才红就已经晚了（本地看不见，等到推送才发现）。而它的**判据是纯静态的**
# （读文件 + 算数 + 正则），裸 Node 不到 0.1 秒，放进钩子没有可感知的代价。
# 实测：加这道闸后的首次全仓扫描就抓到一处真实偏移（tty 英文版 16 写成 8）。
# 放在内部标识之后：上面两道是「内容不许出现什么」，这道是「内容之间要自洽」。
if ! node scripts/check-readme-facts.mjs --staged; then
  echo "✘ [pre-commit] README 里的数字与源码常量已经漂了，已中止（详见上方指引）"
  exit 1
fi
exit 0
